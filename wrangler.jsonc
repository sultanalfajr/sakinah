{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakinah",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sakinah-db",
      "database_id": "dfa77b65-04bc-4678-90ad-15a018034f74"
    }
  ],
  // ✅ اختياري: تخزين R2 يتطلب إضافة بطاقة في Cloudflare — التطبيق يعمل دونها بالكامل
  // (الصوت الجاهز يُقدَّم من الأصول الثابتة، والقرآن يُبثّ من مصادر مجانية)
  // عند توفّر بطاقة لاحقًا فعّل الكتلة التالية وأنشئ الحاوية:
  //   wrangler r2 bucket create sakinah-audio
  // "r2_buckets": [
  //   {
  //     "binding": "AUDIO",
  //     "bucket_name": "sakinah-audio"
  //   }
  // ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "AI_CHAT_MODEL": "gpt-4o-mini",
    "AI_TTS_MODEL": "tts-1",
    "AI_TTS_VOICE": "alloy",
    "AI_TTS_PATH": "/audio/speech"
  }
  // ⚠️ لا تضع AI_API_KEY هنا — أضفها سراً:
  //   wrangler secret put AI_API_KEY
  //   ويمكن ضبط AI_BASE_URL بنفس الطريقة أو إضافته إلى vars بعد اختيار مزوّدك
}
